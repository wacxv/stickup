{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickUp",
  "version": "1.0.0",
  "identifier": "com.wacxv.stickup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StickUp",
        "width": 320,
        "height": 520,
        "minWidth": 280,
        "minHeight": 360,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "wacxv",
    "copyright": "© 2026 wacxv",
    "category": "Productivity",
    "shortDescription": "Sticky notes + task manager",
    "longDescription": "StickUp is a lightweight desktop app combining sticky-note boards with a structured task list. Fully local, no accounts required.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "minimumWebview2Version": "2.0.0.0"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
